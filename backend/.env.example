# ==============================================================================
# FairShare Backend Environment Variables Configuration
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT commit the .env file with real secrets to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME=FairShare Backend
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# CORS Origins (Comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Secret Key for Session / JWT signing
# Generate with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_string_in_production

# Encryption Key for sensitive tokens at rest (e.g. GitHub tokens using Fernet)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=placeholder_base64_32byte_fernet_key_here

# ------------------------------------------------------------------------------
# Database Configuration (Placeholder)
# NOTE: Database models, migrations, and PostgreSQL instance will be provided by
# the Database Teammate. Update this URL once provided.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://fairshare_user:placeholder_password@localhost:5432/fairshare_db

# ------------------------------------------------------------------------------
# GitHub OAuth / App Credentials
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=placeholder_github_client_id
GITHUB_CLIENT_SECRET=placeholder_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# ------------------------------------------------------------------------------
# AI/ML Integration Configuration
# NOTE: Details to be confirmed with AI/ML Teammate:
# - Mode: 'in_process' (direct Python function call) or 'http' (separate microservice)
# - HTTP URL if separate microservice: AIML_SERVICE_URL
# - Timeout in seconds
# ------------------------------------------------------------------------------
AIML_INTEGRATION_MODE=in_process
AIML_SERVICE_URL=http://localhost:8500
AIML_SERVICE_TIMEOUT_SECONDS=60
